                        <Translate>
                            <English>Simonyi Károly College for Advanced Studies</English>
                            <Hungarian>Simonyi Károly Szakkollégium</Hungarian>
                        </Translate>
                    </a>
                    @if (_language is Language.English)
                    {
                        <br/>
                    }
                    <span class="crumb">›</span>
                    <a href="https://kir-dev.hu/@T("en", "hu")">
                        @T(
                            "Kir-Dev web development group",
                            "Kir-Dev webfejlesztő kör"
                        )
                    </a>
                </p>
                <h3>
                    <a href="https://start.sch.bme.hu">StartSCH</a>
                </h3>
                <p class="from">
