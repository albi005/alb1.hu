<CascadingValue Value="@_language">
    <PageTitle>
        @T(
            "Albert Ragány-Németh | CV",
            "Ragány-Németh Albert | Önéletrajz"
        )
    </PageTitle>
    <div class="cv">
        <header class="cv-header">
