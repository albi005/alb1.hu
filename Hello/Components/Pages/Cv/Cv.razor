    </div>

</CascadingValue>

@code {
    private Language _language;
    [CascadingParameter] public required HttpContext HttpContext { get; set; }

    protected override void OnInitialized()
    {
        _language = HttpContext.Request.Path.Value switch
        {
            "/oneletrajz" => Language.Hungarian,
            _ => Language.English,
        };
    }

    private string T(string english, string? hungarian = null)
    {
        return _language switch
        {
            Language.English => english,
            Language.Hungarian => hungarian ?? "TODO(HU)",
            _ => english,
        };
    }

}
