                    <Translate>
                        <English>
                            <ul class="list">
                                <li>Solutions: <a href="https://github.com/albi005/NemesOnline">github.com/albi005/NemesOnline</a></li>
                                <li>2022/2023 – <a href="http://tehetseg.inf.elte.hu/nemes-online/2023/eredmeny3.pdf">11th place</a></li>
                                <li>2021/2022 – <a href="https://tehetseg.inf.elte.hu/nemes-online/2022/eredmeny3.pdf">19th place</a></li>
