            <section class="item">
                <h3>
                    <Translate>
                        <English>DisHelps team</English>
                        <Hungarian>DisHelps csapat</Hungarian>
                    </Translate>
                </h3>
                <p class="sub">
                    <Translate>
                        <English>DisHelps mobile app and server</English>
                        <Hungarian>DisHelps mobilalkalmazás és szerver</Hungarian>
                    </Translate>
                </p>
                <p class="tech">
                    <Translate>
                        <English>Xamarin.Forms & MvvmCross, later .NET MAUI · ASP.NET Core Web APIs · Entity Framework
