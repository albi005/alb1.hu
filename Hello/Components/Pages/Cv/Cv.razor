@page "/cv"
@page "/oneletrajz"

<HeadContent>
    <script type="text/javascript">
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () {
                (c[a].q = c[a].q || []).push(arguments)
            };
            t = l.createElement(r);
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "xrilceqa8y");
    </script>
</HeadContent>

<CascadingValue Value="@_language">
    <PageTitle>
        @T(
            "Albert Ragány-Németh | CV",
            "Ragány-Németh Albert | Önéletrajz"
        )
    </PageTitle>
    <div class="cv">
        <header class="cv-header">
            <h1>
                @T(
                    "Albert Ragány-Németh",
                    "Ragány-Németh Albert"
                )
            </h1>
        </header>

        <p>
            <Translate>
                <English>
                    Computer Engineering BSc student at the Budapest University of Technology and Economics,
                    experienced with .NET, also interested in Rust, looking for an 8 week internship,
                    with additional opportunities later on.
                </English>
            </Translate>
        </p>

        <section class="experience">
            <h2>
                @T(
                    "Experience",
                    "Tapasztalat"
                )
            </h2>
            <section class="kir-dev">
                <h3>
                    <a href="https://simonyi.bme.hu/@T("en", "hu")">
                        @T(
                            "Simonyi Károly College for Advanced Studies",
                            "Simonyi Károly Szakkollégium"
                        )
                    </a>,<br/>
                    <a href="https://kir-dev.hu/@T("en", "hu")">
                        @T(
                            "Kir-Dev web development group",
                            "Kir-Dev webfejlesztő kör"
                        )
                    </a>
                </h3>

                <ul>
                    <li class="item">
                        <div class="title">
                            <Translate>
                                <English><a href="https://kir-dev.hu/en">StartSCH</a></English>
                                <Hungarian><a href="https://kir-dev.hu/hu">StartSCH</a></Hungarian>
                            </Translate>
                            <span class="from">2024 
                            <Translate>
                                <English>oct. – present</English>
                                <Hungarian>okt. – jelen</Hungarian>
                            </Translate>
                        </span>
                        </div>
                        <div class="tech">ASP.NET Core · Entity Framework Core · OpenID Connect</div>
                        <Translate>
                            <English>
                                <p>
                                    I created and lead the development of a website that collects news and events from
                                    the websites of the university and redistributes them to the students.
                                </p>
                            </English>
                            <Hungarian>
                            </Hungarian>
                        </Translate>
                    </li>
                </ul>
            </section>
            <section class="item">
                <h3>
                    <a href="https://github.com/albi005/MaterialColorUtilities">
                        MaterialColorUtilities
                    </a>
                </h3>
                <pre>
                    - 78 stars on GitHub
                    - 99.5K total downloads on NuGet
                </pre>
                <p>
                    <Translate>
                        <English>
                            I ported Google's Material You design system helper library to C#/.NET and published it on
                            NuGet.
                        </English>
                        <Hungarian>
                        </Hungarian>
                    </Translate>
                </p>
                <p class="note">
                    <Translate>
                        <English>
                            As a testament to the quality of the documentation, it was
                            <a href="https://github.com/luisbocanegra/kde-material-you-colors/tree/b380c12f8de8c8ee3f395c383406dc0f40e9e4e0#thanks--credits">
                                <q>found the easiest to work with</q>
                            </a>
                            even by someone building on Linux with Python, before there was a Python version.
                        </English>
                        <Hungarian>
                        </Hungarian>
                    </Translate>
                </p>
            </section>
            <section class="item">
                <h3>
                    <Translate>
                        <English>DisHelps team</English>
                        <Hungarian>DisHelps csapat</Hungarian>
                    </Translate>
                </h3>
                <div class="title">
                    <Translate>
                        <English>DisHelps mobile app and server</English>
                        <Hungarian>DisHelps mobilalkalmazás és szerver</Hungarian>
                    </Translate>
                </div>
                <div class="project">
                    <Translate>
                        <English>Xamarin.Forms & MvvmCross, later .NET MAUI · ASP.NET Core Web APIs · Entity Framework
                            Core
                        </English>
                        <Hungarian>Xamarin.Forms & MvvmCross, később .NET MAUI · ASP.NET Core Web APIs · Entity
                            Framework Core
                        </Hungarian>
                    </Translate>
                </div>
                <p>
                    <Translate>
                        <English>
                            I started learning programming after joining the DisHelps team.

                            I took over the project after a while and:
                            - migrated the repository, including the Git repository and the wiki from Azure DevOps to
                            GitHub,
                            - set up automatic CI/CD using GitHub Actions deploying to the Google Play Store and the
                            Apple App Store,
                            - simplified the project structure, and later migrated from Xamarin.Forms to .NET MAUI,
                            - continued developing the app,
                            - integrated Piranha CMS for managing the knowledge base section of the app.

                            Managing a larger project let me experiment freely:
                            I refactored major parts of the code base multiple times,
                            simplifying the code base even more each time.
                        </English>
                        <Hungarian>
                            A DisHelps csapat tagjaként fejlesztettem a mobilalkalmazást és a mögötte álló szervert.
                        </Hungarian>
                    </Translate>
                </p>
            </section>
        </section>

        <section class="studies">
            <h2>
                <Translate>
                    <English>Studies</English>
                    <Hungarian>Tanulmányok</Hungarian>
                </Translate>
            </h2>
            <section class="item">
                <div class="title">
                    <Translate>
                        <English><strong>Computer Engineering BSc</strong>, 2023 sept. - <i>2027 jan.</i></English>
                        <Hungarian><strong>Mérnökinformatikus BSc</strong>, 2023 szept. - <i>2027 jan.</i></Hungarian>
                    </Translate>
                </div>
                <div class="project">
                    <Translate>
                        <English>Budapest University of Technology and Economics</English>
                        <Hungarian>Budapesti Műszaki és Gazdaságtudományi Egyetem</Hungarian>
                    </Translate>
                </div>
            </section>
            <pre>
            - Eötvös József Gimnázium, Tata, matematika tagozat
              - Érettségi:
                - Emelt informatika: 97%
                - Matematika: 98%
                - Angol: 98%
            </pre>
        </section>

        <section class="competitions">
            <h2>
                @T("Competitions", "Versenyek")
            </h2>
            <pre>
            - Advent of Code
                - Daily code puzzles for 25 days, getting harder over time
                - 50/50 stars, Rust
                - [2024] 50* / 50* - https://github.com/albi005/advent-of-code-2024 - Rust
                  [2023] 15* / 50* - https://github.com/albi005/advent-of-code-rust - Rust
                  [2022] 26* / 50* - https://github.com/albi005/AdventOfCode2022 - C#
            - [Nemes Tihamér Online Programozási Verseny](https://tehetseg.inf.elte.hu/nemes-online/index.html)
                - Solutions: https://github.com/albi005/NemesOnline
                - 2022/2023 - [11. hely](http://tehetseg.inf.elte.hu/nemes-online/2023/eredmeny3.pdf)
                - 2021/2022 - [19. hely](https://tehetseg.inf.elte.hu/nemes-online/2022/eredmeny3.pdf)
                - 2020/2021 - [55. hely](https://tehetseg.inf.elte.hu/nemes-online/2021/eredmeny2.pdf)
            - [World Robot Olympiad](https://wro-association.org/), 2017, 2018, [2019](https://photos.app.goo.gl/XFj2AEYG5a4FQ9k68)
                - Designed and programmed LEGO robots that completed autonomous tasks,
                  reaching better placements at the competition each year.
            </pre>
        </section>
    </div>

</CascadingValue>

@code {
    private Language _language;
    [CascadingParameter] public required HttpContext HttpContext { get; set; }

    protected override void OnInitialized()
    {
        _language = HttpContext.Request.Path.Value switch
        {
            "/oneletrajz" => Language.Hungarian,
            _ => Language.English,
        };
    }

    private string T(string english, string? hungarian = null)
    {
        return _language switch
        {
            Language.English => english,
            Language.Hungarian => hungarian ?? "TODO: HU",
            _ => english,
        };
    }

}
