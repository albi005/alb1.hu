                <li class="item">
                    <h3>
                        <a href="https://tehetseg.inf.elte.hu/nemes-online/index.html">
                            <Translate>
                                <English>Nemes Tihamér Online Programming Competition</English>
                                <!-- TODO: Hungarian translation -->
                            </Translate>
