@switch (CurrentLanguage)
{
    case Language.English:
        @(English ?? ChildContent)
        break;
    case Language.Hungarian:
        if (Hungarian is { })
        {
            @Hungarian
        }
        else
        {
            @:TODO(HU)
        }
        break;
    default:
        throw new InvalidOperationException();
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? English { get; set; }
    [Parameter] public RenderFragment? Hungarian { get; set; }
    [CascadingParameter] public Language CurrentLanguage { get; set; }
}
